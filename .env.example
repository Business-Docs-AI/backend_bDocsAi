POSTGRES_DB=business_docs_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

PGADMIN_EMAIL=
PGADMIN_PASSWORD=

SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://postgres:5432/business_docs_ai
DB_USERNAME=postgres
DB_PASSWORD=

# Segredo usado para assinar os tokens JWT (HS256 exige pelo menos 256 bits / 32 bytes).
# Gere um valor próprio em produção, ex.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Qual provedor usar para o CHAT: "gemini" (padrão, gratuito), "anthropic" ou "openai".
AI_CHAT_PROVIDER=gemini

# Qual provedor usar para EMBEDDINGS (indexação/busca semântica): "local" (padrão, roda em
# processo via ONNX, sem chave nenhuma) ou "openai".
AI_EMBEDDING_PROVIDER=local

# Só necessário se AI_EMBEDDING_PROVIDER=openai (ou AI_CHAT_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Chave do Google AI Studio usada pelo LangChain4j para o chat quando AI_CHAT_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Chave da Anthropic usada pelo LangChain4j para o chat quando AI_CHAT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5